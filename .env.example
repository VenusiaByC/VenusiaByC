# Copie ce fichier en ".env.local" et remplis les valeurs.
# Ne jamais committer le fichier ".env.local" (il est déjà ignoré par git).

# --- Supabase (base de données + authentification) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (ton adresse professionnelle, via SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Venusia
SMTP_FROM_EMAIL=

# --- SMS (Brevo) ---
BREVO_API_KEY=
BREVO_SMS_SENDER=Venusia

# --- Sécurité de la tâche planifiée (rappels SMS 48h) ---
CRON_SECRET=

# --- Stripe (paiement en ligne + cartes cadeaux) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
